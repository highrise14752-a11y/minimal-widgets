<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.telephony" android:required="false" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Minimal Widgets" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <receiver android:name=".BatteryPinReceiver" android:exported="false" />
    <receiver android:name=".BatteryReceiver" android:exported="true" android:label="Battery 2 × 2">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_widget_info" />
    </receiver>
    <receiver android:name=".ClockWidgetReceiver" android:exported="true" android:label="Clock &amp; date">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info" />
    </receiver>
    <activity android:name=".SettingsActivity" android:exported="false" />
    <activity android:name=".QuickActionActivity" android:exported="false" android:excludeFromRecents="true" />
    <receiver android:name=".QuickPinReceiver" android:exported="false" />
    <receiver android:name=".QuickSettingsReceiver" android:exported="true" android:label="Quick control">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_widget_info" />
    </receiver>
    <activity android:name=".ContactActionActivity" android:exported="false" android:excludeFromRecents="true" />
    <activity android:name=".ContactConfigActivity" android:exported="false" />
    <receiver android:name=".ContactReceiver" android:exported="true" android:label="Contact call and message">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/contact_widget_info" />
    </receiver>
    <receiver android:name=".CallReceiver" android:exported="true" android:label="Direct call">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/contact_widget_info" />
    </receiver>
    <receiver android:name=".MessageReceiver" android:exported="true" android:label="Message contact">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/contact_widget_info" />
    </receiver>
    <receiver android:name=".MusicReceiver" android:exported="true" android:label="Music play and pause">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/contact_widget_info" />
    </receiver>
    <activity android:name=".WidgetConfigActivity" android:exported="false" />
    <receiver android:name=".PhotoReceiver" android:exported="true" android:label="Photo">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/photo_widget_info" />
    </receiver>
    <receiver android:name=".FolderReceiver" android:exported="true" android:label="App folder">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/folder_widget_info" />
    </receiver>
    <receiver android:name=".VolumeReceiver" android:exported="true" android:label="Volume">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/volume_widget_info" />
    </receiver>
    <receiver android:name=".WifiReceiver" android:exported="true" android:label="Wi-Fi settings">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/wifi_widget_info" />
    </receiver>
    <receiver android:name=".DataReceiver" android:exported="true" android:label="Mobile data settings">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/data_widget_info" />
    </receiver>
    <receiver android:name=".NoteReceiver" android:exported="true" android:label="Personal note">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/note_widget_info" />
    </receiver>
    <receiver android:name=".BatteryWideReceiver" android:exported="true" android:label="Battery 2 × 1">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_wide_widget_info" />
    </receiver>
    <receiver android:name=".BatteryTallReceiver" android:exported="true" android:label="Battery 1 × 2">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_tall_widget_info" />
    </receiver>
    <receiver android:name=".BatteryLargeReceiver" android:exported="true" android:label="Battery 4 × 2">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_large_widget_info" />
    </receiver>
    <receiver android:name=".BatterySmallReceiver" android:exported="true" android:label="Battery 1 × 1">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_small_widget_info" />
    </receiver>
  </application>
</manifest>
