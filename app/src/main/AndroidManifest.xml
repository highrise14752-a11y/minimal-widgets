<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Minimal Widgets" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <receiver android:name=".BatteryPinReceiver" android:exported="false" />
    <receiver android:name=".BatteryReceiver" android:exported="true" android:label="Battery">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_widget_info" />
    </receiver>
    <receiver android:name=".ClockWidgetReceiver" android:exported="true" android:label="Clock &amp; date">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info" />
    </receiver>
    <activity android:name=".SettingsActivity" android:exported="false" />
    <activity android:name=".WidgetConfigActivity" android:exported="false" />
    <receiver android:name=".PhotoReceiver" android:exported="true" android:label="Photo">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/photo_widget_info" />
    </receiver>
    <receiver android:name=".FolderReceiver" android:exported="true" android:label="App folder">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/folder_widget_info" />
    </receiver>
    <receiver android:name=".VolumeReceiver" android:exported="true" android:label="Volume">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/volume_widget_info" />
    </receiver>
    <receiver android:name=".WifiReceiver" android:exported="true" android:label="Wi-Fi settings">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/wifi_widget_info" />
    </receiver>
    <receiver android:name=".DataReceiver" android:exported="true" android:label="Mobile data settings">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/data_widget_info" />
    </receiver>
    <receiver android:name=".NoteReceiver" android:exported="true" android:label="Personal note">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/note_widget_info" />
    </receiver>
  </application>
</manifest>
