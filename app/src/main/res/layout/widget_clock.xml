<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/widget_root" android:orientation="vertical" android:gravity="center" android:padding="4dp" android:background="#191919">
    <TextClock android:id="@+id/time" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp"
        android:gravity="center" android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:textSize="40sp" android:textColor="#FFC000" android:fontFamily="sans-serif-light" />
    <TextClock android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM"
        android:textSize="14sp" android:textColor="#CCCCCC" />
</LinearLayout>

